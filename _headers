# Netlify headers — ends up next to index.html after Unity WebGL build.
# Your publish folder MUST contain: index.html, Build/, TemplateData/, opencv.js, wtracker.js, …

# ---- Uncompressed build (Player Settings → Compression Format: Disabled) ----
/Build/*.wasm
  Content-Type: application/wasm

/Build/*.data
  Content-Type: application/octet-stream

/Build/*.js
  Content-Type: application/javascript

# ---- Gzip build (Compression Format: Gzip) — only used if *.gz files exist ----
/Build/*.wasm.gz
  Content-Type: application/wasm
  Content-Encoding: gzip

/Build/*.data.gz
  Content-Type: application/octet-stream
  Content-Encoding: gzip

/Build/*.js.gz
  Content-Type: application/javascript
  Content-Encoding: gzip

/Build/*.framework.js.gz
  Content-Type: application/javascript
  Content-Encoding: gzip

# ---- Brotli build (Compression Format: Brotli) — only used if *.br files exist ----
/Build/*.wasm.br
  Content-Type: application/wasm
  Content-Encoding: br

/Build/*.data.br
  Content-Type: application/octet-stream
  Content-Encoding: br

/Build/*.js.br
  Content-Type: application/javascript
  Content-Encoding: br

/Build/*.framework.js.br
  Content-Type: application/javascript
  Content-Encoding: br
